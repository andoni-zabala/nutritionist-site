---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = "Mabel Gomez — Licenciada en Nutrición",
  description = "Nutrición basada en evidencia adaptada a tu biología, estilo de vida y objetivos. Sin dietas milagro — solo cambios duraderos.",
  canonicalURL = Astro.url.href,
  ogImage = "/og-image.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Mabel Gomez Nutrición",
      description:
        "Nutrición basada en evidencia. Sin dietas milagro — solo cambios duraderos.",
      inLanguage: "es-AR",
    },
    {
      "@type": ["MedicalBusiness", "LocalBusiness"],
      "@id": `${siteUrl}/#business`,
      name: "Mabel Gomez — Licenciada en Nutrición",
      url: siteUrl,
      telephone: "+54 9 11 6659 8030",
      email: "nutrymaby@gmail.com",
      image: `${siteUrl}/uploads/mabel.webp`,
      priceRange: "$$",
      currenciesAccepted: "ARS",
      paymentAccepted: "Cash, Credit Card, Bank Transfer",
      address: {
        "@type": "PostalAddress",
        addressCountry: "AR",
        addressLocality: "Buenos Aires",
      },
      areaServed: [
        { "@type": "Country", name: "Argentina" },
        { "@type": "AdministrativeArea", name: "Buenos Aires" },
      ],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "09:00",
          closes: "18:00",
        },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios de Nutrición",
        itemListElement: [
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Primera Consulta Nutricional",
              description:
                "Evaluación integral de historial de salud, hábitos alimentarios y elaboración de plan nutricional personalizado basado en evidencia.",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Seguimiento Nutricional",
              description:
                "Consultas periódicas para revisar progreso y ajustar el plan nutricional cada 3–4 semanas.",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Consulta Online",
              description:
                "Consultas nutricionales por videollamada con la misma calidad que las presenciales.",
            },
          },
        ],
      },
      sameAs: [],
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: "Mabel Gomez",
      jobTitle: "Licenciada en Nutrición",
      description:
        "Nutricionista especializada en nutrición basada en evidencia, microbiota intestinal e inflamación crónica. Atiende en Buenos Aires y online.",
      url: siteUrl,
      image: `${siteUrl}/uploads/mabel.webp`,
      email: "nutrymaby@gmail.com",
      telephone: "+54 9 11 6659 8030",
      worksFor: { "@id": `${siteUrl}/#business` },
      knowsAbout: [
        "Nutrición basada en evidencia",
        "Microbiota intestinal",
        "Inflamación crónica",
        "Pérdida de peso sostenible",
        "Energía y bienestar",
        "Dietoterapia",
      ],
      hasCredential: {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "degree",
        name: "Licenciada en Nutrición",
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      mainEntity: [
        {
          "@type": "Question",
          name: "¿Qué incluye la primera consulta con Mabel Gomez?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "La primera consulta incluye una evaluación integral del historial de salud, hábitos alimentarios, análisis de laboratorio y objetivos personales. Se elabora un plan nutricional personalizado basado en evidencia científica.",
          },
        },
        {
          "@type": "Question",
          name: "¿Ofrecen consultas de nutrición online?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sí. Mabel Gomez ofrece consultas de nutrición completamente online por videollamada, con la misma calidad que las consultas presenciales en Buenos Aires, Argentina.",
          },
        },
        {
          "@type": "Question",
          name: "¿Cuánto tiempo tarda en verse resultados con una nutricionista?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Los cambios en energía y digestión suelen notarse en 2–4 semanas. Los cambios en composición corporal sostenibles toman entre 2 y 6 meses dependiendo del objetivo y punto de partida de cada persona.",
          },
        },
        {
          "@type": "Question",
          name: "¿En qué se especializa la nutricionista Mabel Gomez?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Mabel Gomez es Licenciada en Nutrición especializada en nutrición basada en evidencia, salud de la microbiota intestinal, manejo de inflamación crónica, pérdida de peso sostenible y optimización de energía.",
          },
        },
        {
          "@type": "Question",
          name: "¿Cómo funciona el seguimiento nutricional?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "El seguimiento incluye consultas periódicas para revisar el progreso, ajustar el plan nutricional según tu evolución y resolver dudas. La frecuencia se adapta a cada persona, típicamente cada 3–4 semanas.",
          },
        },
        {
          "@type": "Question",
          name: "¿La nutricionista hace dietas restrictivas?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. El enfoque de Mabel Gomez rechaza las dietas milagro y los regímenes extremadamente restrictivos. Los planes son individualizados, basados en evidencia científica y orientados a cambios sostenibles a largo plazo.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Mabel Gomez" />
    <meta name="theme-color" content="#1B3A1A" />
    {
      noindex ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <meta
          name="robots"
          content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
        />
      )
    }
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/uploads/logo.webp" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Mabel Gomez Nutrición" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <script
      is:inline
      src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garant:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function (user) {
          if (!user) {
            window.netlifyIdentity.on("login", function () {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 },
      );
      document
        .querySelectorAll(".reveal")
        .forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
