---
const services = [
  {
    number: "01",
    title: "Primera consulta",
    tagline: "Duración aproximada: 60 minutos",
    description:
      "Evaluamos tu situación actual, tus objetivos y tu historial alimentario. Salís con un diagnóstico claro y los primeros pasos de tu plan personalizado.",
    features: [
      "Evaluación nutricional completa y laboratorio",
      "Definición de objetivos reales",
      "Plan inicial personalizado",
      "Suplementación funcional",
    ],
    price: "Consultar",
    featured: true,
    icon: "◎",
  },
  {
    number: "02",
    title: "Seguimiento/Control",
    tagline: "Duración aproximada: 40 minutos",
    description:
      "Revisamos cómo vas, ajustamos el plan según tus avances y resolvemos las dudas que van surgiendo. El seguimiento es clave para sostener los resultados.",
    features: [
      "Revisión de avances",
      "Ajuste del plan alimentario",
      "Resolución de dudas",
      "Acompañamiento entre consultas",
    ],
    price: "Consultar",
    featured: false,
    icon: "◈",
  },
  {
    number: "03",
    title: "Consulta online",
    tagline: "Desde donde estés",
    description:
      "Mismo nivel de atención personalizada, sin moverte de tu casa. Videoconsulta con seguimiento remoto y material digital incluido.",
    features: [
      "Videoconsulta en vivo",
      "Material digital incluido",
      "Seguimiento por mensaje",
      "Horarios flexibles",
    ],
    price: "Consultar",
    featured: false,
    icon: "◇",
  },
];
---

<section class="services" id="services">
  <div class="services-inner">
    <div class="services-header">
      <div class="section-tag reveal">Servicios</div>
      <h2 class="services-heading reveal reveal-delay-1">
        ¿En qué puedo<br /><em>ayudarte?</em>
      </h2>
      <p class="services-sub reveal reveal-delay-2">
        Cada servicio está diseñado para lograr cambios reales y sostenibles —
        sin soluciones mágicas ni protocolos genéricos.
      </p>
      <div class="services-areas reveal reveal-delay-3">
        <span class="area-tag">Descenso de peso</span>
        <span class="area-tag">Mejora de hábitos</span>
        <span class="area-tag">Nutrición antiinflamatoria</span>
        <span class="area-tag">Salud digestiva</span>
        <span class="area-tag">Microbiota intestinal</span>
        <span class="area-tag">Bienestar general</span>
      </div>
    </div>

    <div class="services-grid">
      {
        services.map((s, i) => (
          <div
            class={`service-card ${s.featured ? "service-card--featured" : ""} reveal reveal-delay-${i + 2}`}
          >
            <div class="card-top">
              <div class="card-number">{s.number}</div>
              <div class="card-icon">{s.icon}</div>
            </div>
            <h3 class="card-title">{s.title}</h3>
            <p class="card-tagline">{s.tagline}</p>
            <p class="card-desc">{s.description}</p>
            <ul class="card-features">
              {s.features.map((f) => (
                <li>
                  <span class="feat-check" aria-hidden="true">
                    ✓
                  </span>
                  {f}
                </li>
              ))}
            </ul>
            <div class="card-footer">
              <span class="card-price">{s.price}</span>
              <a
                href="#contact"
                class={s.featured ? "btn-primary" : "btn-outline"}
              >
                Reservar turno
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p class="services-modality reveal">
      <span aria-hidden="true">📍</span>
      Disponible online y presencial — en todo el país.
    </p>
  </div>
</section>

<style>
  .services {
    padding: 8rem 2.5rem;
    background: var(--color-cream);
  }

  .services-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .services-header {
    max-width: 560px;
    margin-bottom: 4rem;
  }

  .services-heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    line-height: 1.1;
    color: var(--color-forest);
    margin-bottom: 1.25rem;
  }

  .services-heading em {
    font-style: italic;
    color: var(--color-terra);
  }

  .services-sub {
    font-size: 1rem;
    line-height: 1.75;
    color: #666;
    font-weight: 300;
  }

  /* Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .service-card {
    background: white;
    border-radius: 20px;
    padding: 2.25rem;
    border: 1.5px solid var(--color-cream-dark);
    display: flex;
    flex-direction: column;
    gap: 0;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.08);
  }

  .service-card--featured {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }

  .service-card--featured .card-number,
  .service-card--featured .card-title,
  .service-card--featured .card-tagline,
  .service-card--featured .card-desc {
    color: var(--color-cream);
  }

  .service-card--featured .card-price {
    color: var(--color-sage-light);
  }

  .service-card--featured .feat-check {
    color: var(--color-sage-light);
  }

  .service-card--featured .card-features li {
    color: rgba(250, 247, 240, 0.8);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .card-number {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-sage);
  }

  .service-card--featured .card-number {
    color: var(--color-sage-light);
  }

  .card-icon {
    font-size: 1.5rem;
    color: var(--color-gold);
    opacity: 0.7;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-forest);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .card-tagline {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-sage);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .card-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #666;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .card-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
    flex: 1;
  }

  .card-features li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #555;
    font-weight: 400;
  }

  .feat-check {
    color: var(--color-sage);
    font-size: 0.75rem;
    flex-shrink: 0;
    font-weight: 600;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.07);
  }

  .service-card--featured .card-footer {
    border-top-color: rgba(255, 255, 255, 0.12);
  }

  .card-price {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-forest);
  }

  .services-areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .area-tag {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-forest);
    background: rgba(27, 58, 26, 0.07);
    border: 1px solid rgba(27, 58, 26, 0.12);
    padding: 0.3rem 0.85rem;
    border-radius: 100px;
    white-space: nowrap;
  }

  .services-modality {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: #888;
    font-weight: 300;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }

  @media (max-width: 480px) {
    .services {
      padding: 5rem 1.5rem;
    }
  }
</style>
