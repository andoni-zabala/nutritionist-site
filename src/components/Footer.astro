---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="footer-name">Mabel Gomez</span>
        <span class="footer-sub">Lic. en Nutrición</span>
      </a>
      <p class="footer-tagline">
        Ayudándote a construir una relación saludable con la comida —
        un hábito sostenible a la vez.
      </p>
    </div>

    <div class="footer-nav">
      <span class="footer-nav-label">Navegación</span>
      <ul>
        <li><a href="#about">Sobre mí</a></li>
        <li><a href="#services">Servicios</a></li>
        <li><a href="#approach">Enfoque</a></li>
        <li><a href="#testimonials">Testimonios</a></li>
        <li><a href="#contact">Contacto</a></li>
      </ul>
    </div>

    <div class="footer-nav">
      <span class="footer-nav-label">Conecta</span>
      <ul>
        <li><a href="https://wa.me/5491157553726" target="_blank" rel="noopener noreferrer" class="wa-link">WhatsApp</a></li>
        <li><a href="https://www.instagram.com/nutry_maby/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://www.linkedin.com/in/mabel-gomez-0bba28198/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href="mailto:contacto@nutricionmabel.com">Email</a></li>
      </ul>
    </div>

    <div class="footer-cta-col">
      <p class="footer-cta-text">¿Lista para comenzar?</p>
      <a
        href="https://wa.me/5491157553726?text=Hola%20Mabel%2C%20Me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n%20sobre%20tus%20consultas%20nutricionales.%20%C2%BFPodr%C3%ADas%20indicarme%20c%C3%B3mo%20son%20las%20consultas%20y%20la%20disponibilidad%3F"
        class="btn-primary btn-footer-wa"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
