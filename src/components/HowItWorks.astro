---
const waUrl = "https://wa.me/message/BTY5IEGJWF67F1";

const steps = [
  {
    number: '01',
    title: 'Agendás tu consulta',
    body: 'Me escribís por WhatsApp y coordinamos un horario. Online o presencial, vos elegís.',
  },
  {
    number: '02',
    title: 'Evaluamos tu situación y objetivos',
    body: 'Hablamos de tu historia, tus hábitos, lo que comés y lo que querés lograr. Sin juicios.',
  },
  {
    number: '03',
    title: 'Recibís un plan personalizado',
    body: 'Te entrego un plan alimentario diseñado específicamente para vos, con recetas y guías prácticas.',
  },
  {
    number: '04',
    title: 'Hacemos seguimiento para sostener resultados',
    body: 'Nos reunimos regularmente para ajustar el plan y asegurarnos de que estés avanzando hacia tus objetivos.',
  },
];
---

<section class="how" id="how-it-works">
  <div class="how-inner">

    <div class="how-header">
      <div class="section-tag reveal">El proceso</div>
      <h2 class="how-heading reveal reveal-delay-1">Cómo funciona</h2>
      <p class="how-sub reveal reveal-delay-2">
        Cuatro pasos simples para empezar a mejorar tu alimentación de forma real y sostenible.
      </p>
    </div>

    <div class="how-steps">
      {steps.map((step, i) => (
        <>
          <div class={`step reveal reveal-delay-${i + 1}`}>
            <div class="step-number" aria-hidden="true">{step.number}</div>
            <div class="step-content">
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </div>
          </div>
          {i < steps.length - 1 && (
            <div class="step-connector" aria-hidden="true"></div>
          )}
        </>
      ))}
    </div>

    <div class="how-cta reveal">
      <a
        href={waUrl}
        class="btn-primary btn-how-wa"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Empezar ahora
      </a>
    </div>

  </div>
</section>

<style>
  .how {
    padding: 8rem 2.5rem;
    background: var(--color-cream-dark);
  }

  .how-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .how-header {
    max-width: 560px;
    margin-bottom: 4.5rem;
  }

  .how-heading {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    line-height: 1.1;
    color: var(--color-forest);
    font-weight: 400;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
  }

  .how-sub {
    font-size: 1rem;
    line-height: 1.75;
    color: #666;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  /* Desktop: 4 steps with 3 connectors between them */
  .how-steps {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: start;
    margin-bottom: 4rem;
  }

  .step {
    padding: 0 1rem;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 500;
    color: var(--color-sage-light);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-forest);
    font-weight: 500;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .step-body {
    font-size: 0.9rem;
    line-height: 1.75;
    color: #666;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .step-connector {
    width: 48px;
    height: 1px;
    background: rgba(27, 58, 26, 0.2);
    margin-top: 1.75rem;
    position: relative;
    flex-shrink: 0;
  }

  .step-connector::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3px;
    width: 6px;
    height: 6px;
    border-top: 1.5px solid rgba(27, 58, 26, 0.3);
    border-right: 1.5px solid rgba(27, 58, 26, 0.3);
    transform: rotate(45deg);
  }

  .how-cta {
    display: flex;
    justify-content: center;
  }

  .btn-how-wa {
    display: inline-flex !important;
    align-items: center;
    gap: 0.5rem;
    background: #25D366 !important;
    border-color: #25D366 !important;
  }

  .btn-how-wa:hover {
    background: #1ebe5d !important;
    border-color: #1ebe5d !important;
  }

  @media (max-width: 1024px) {
    .how-steps {
      grid-template-columns: 1fr;
    }

    .step {
      padding: 0;
    }

    .step-connector {
      width: 1px;
      height: 32px;
      margin-top: 0;
      margin-left: 0;
      background: rgba(27, 58, 26, 0.2);
    }

    .step-connector::after {
      right: -3px;
      top: auto;
      bottom: -1px;
      transform: rotate(135deg);
    }
  }

  @media (max-width: 480px) {
    .how {
      padding: 5rem 1.5rem;
    }
  }
</style>
