---
const testimonials = [
  {
    quote:
      "Trabajar con Mabel cambió completamente mi relación con la comida. Los planes personalizados se adaptaron perfecto a mi estilo de vida. Lo más importante es que aprendí a comer de manera consciente y sin culpa.",
    name: "Laura M.",
    role: "Diseñadora, 35",
    avatar: "LM",
    result: "Salud digestiva mejorada",
  },
  {
    quote:
      "Después de años lidiando con problemas digestivos, Mabel me ayudó a entender la importancia de la microbiota. Su enfoque personalizado y basado en evidencia científica hizo toda la diferencia. Me siento mucho mejor.",
    name: "Carlos R.",
    role: "Ingeniero industrial, 42",
    avatar: "CR",
    result: "Inflamación reducida",
  },
  {
    quote:
      "El seguimiento continuo que ofrece Mabel fue fundamental para alcanzar mis objetivos. Su conocimiento sobre nutrición antiinflamatoria es excelente. Muy profesional y atenta a cada detalle.",
    name: "Mariana F.",
    role: "Arquitecta, 28",
    avatar: "MF",
    result: "Más energía y bienestar",
  },
];
---

<section class="testimonials" id="testimonials">
  <div class="testimonials-inner">
    <div class="testimonials-header">
      <div class="section-tag reveal">Testimonios</div>
      <h2 class="t-heading reveal reveal-delay-1">
        Lo que dicen mis pacientes
      </h2>
    </div>

    <!-- Results dashboard strip -->
    <div class="results-strip reveal reveal-delay-2">
      <div class="result-stat">
        <div class="result-icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path
              d="M3 14L7 9L10 12L14 6L17 9"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <circle cx="17" cy="9" r="1.5" fill="currentColor" opacity="0.6"
            ></circle>
          </svg>
        </div>
        <span class="result-num">+100</span>
        <span class="result-label">pacientes acompañados</span>
      </div>
      <div class="result-sep" aria-hidden="true"></div>
      <div class="result-stat">
        <div class="result-icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle
              cx="10"
              cy="10"
              r="7"
              stroke="currentColor"
              stroke-width="1.5"></circle>
            <path
              d="M7 10L9.5 12.5L13 8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <span class="result-num">87%</span>
        <span class="result-label">logran sus objetivos</span>
      </div>
      <div class="result-sep" aria-hidden="true"></div>
      <div class="result-stat">
        <div class="result-icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path
              d="M10 4C10 4 5 7 5 11.5C5 14.5 7.2 17 10 17C12.8 17 15 14.5 15 11.5C15 7 10 4 10 4Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"></path>
            <path
              d="M10 17V19"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <span class="result-num">8+ años</span>
        <span class="result-label">de experiencia clínica</span>
      </div>
    </div>

    <div class="t-grid">
      {
        testimonials.map((t, i) => (
          <article class={`t-card reveal reveal-delay-${i + 1}`}>
            <div class="t-stars" aria-label="5 stars">
              ★★★★★
            </div>
            <blockquote class="t-quote">"{t.quote}"</blockquote>
            <div class="t-footer">
              <div class="t-avatar" aria-hidden="true">
                {t.avatar}
              </div>
              <div class="t-meta">
                <span class="t-name">{t.name}</span>
                <span class="t-role">{t.role}</span>
              </div>
              <div class="t-result">
                <span class="result-icon">✦</span>
                {t.result}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding: 8rem 2.5rem;
    background: var(--color-cream-dark);
  }

  .testimonials-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .testimonials-header {
    margin-bottom: 3.5rem;
  }

  .t-heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    color: var(--color-forest);
    line-height: 1.1;
  }

  /* Results strip */
  .results-strip {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--color-forest);
    border-radius: 16px;
    padding: 1.5rem 2.5rem;
    margin-bottom: 3.5rem;
    overflow: hidden;
  }

  .result-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    padding: 0 1rem;
  }

  .result-icon-wrap {
    color: var(--color-gold);
    opacity: 0.8;
    margin-bottom: 0.15rem;
  }

  .result-num {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 500;
    color: var(--color-cream);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .result-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(250, 247, 240, 0.55);
    font-weight: 400;
  }

  .result-sep {
    width: 1px;
    height: 52px;
    background: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  /* Grid */
  .t-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .t-card {
    background: white;
    border-radius: 20px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1.5px solid transparent;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .t-card:hover {
    border-color: var(--color-cream-dark);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.07);
  }

  .t-stars {
    color: var(--color-gold);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  .t-quote {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-ink);
    font-style: normal;
    font-weight: 400;
    flex: 1;
    border: none;
    padding: 0;
  }

  .t-footer {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-cream-dark);
    flex-wrap: wrap;
  }

  .t-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-forest);
    color: var(--color-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .t-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
  }

  .t-name {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-forest);
  }

  .t-role {
    font-size: 0.72rem;
    color: #999;
    font-weight: 300;
  }

  .t-result {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(122, 158, 104, 0.12);
    color: var(--color-forest);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .result-icon {
    color: var(--color-gold);
    font-size: 0.6rem;
  }

  /* CTA */
  .t-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 3rem;
    background: white;
    border-radius: 20px;
    border: 1.5px solid var(--color-cream-dark);
  }

  .t-cta p {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-forest);
    font-weight: 400;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .t-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
    }

    .results-strip {
      flex-wrap: wrap;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .result-stat {
      flex: 1;
      min-width: 120px;
    }

    .result-sep {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .testimonials {
      padding: 5rem 1.5rem;
    }

    .results-strip {
      padding: 1.25rem 1rem;
    }
  }
</style>
