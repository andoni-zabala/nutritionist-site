---
---

<section class="about" id="about">
  <div class="about-inner">
    <div class="about-image-col reveal">
      <div class="about-frame">
        <!-- Replace with <img src="..." alt="Sofía Martínez"> -->
        <div class="about-img-placeholder">
          <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="50" cy="36" r="18" stroke="#7A9E68" stroke-width="1.2"/>
            <path d="M14 90C14 68 29 58 50 58C71 58 86 68 86 90" stroke="#7A9E68" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          <span>Photo coming soon</span>
        </div>
        <div class="about-frame-deco" aria-hidden="true"></div>
      </div>

      <div class="about-credentials reveal reveal-delay-2">
        <div class="cred-item">
          <span class="cred-icon">🎓</span>
          <div>
            <div class="cred-title">MSc Clinical Nutrition</div>
            <div class="cred-sub">University of Barcelona, 2016</div>
          </div>
        </div>
        <div class="cred-item">
          <span class="cred-icon">🏅</span>
          <div>
            <div class="cred-title">Registered Nutritionist</div>
            <div class="cred-sub">CODINUCAT Certified</div>
          </div>
        </div>
        <div class="cred-item">
          <span class="cred-icon">🌱</span>
          <div>
            <div class="cred-title">Functional Medicine</div>
            <div class="cred-sub">IFM Certified Practitioner</div>
          </div>
        </div>
      </div>
    </div>

    <div class="about-text-col">
      <div class="section-tag reveal">About me</div>

      <h2 class="about-heading reveal reveal-delay-1">
        Food as medicine.<br />
        <em>Science as guide.</em>
      </h2>

      <p class="about-p reveal reveal-delay-2">
        I'm Sofía — a registered nutritionist with over 8 years helping people
        rebuild their relationship with food. My practice is rooted in
        functional nutrition and the belief that there is no universal diet:
        <strong>your body is unique, and your nutrition plan should be too.</strong>
      </p>

      <p class="about-p reveal reveal-delay-3">
        I work with people dealing with hormonal imbalances, gut issues,
        metabolic conditions, and those who simply want to feel more energised
        and at home in their body — without the obsession and restriction that
        most diets demand.
      </p>

      <div class="about-values reveal reveal-delay-4">
        <div class="value">
          <span class="value-icon">✦</span>
          <span>Bio-individual approach</span>
        </div>
        <div class="value">
          <span class="value-icon">✦</span>
          <span>Evidence-based methods</span>
        </div>
        <div class="value">
          <span class="value-icon">✦</span>
          <span>No restriction culture</span>
        </div>
        <div class="value">
          <span class="value-icon">✦</span>
          <span>Root cause focus</span>
        </div>
      </div>

      <a href="#contact" class="btn-primary reveal reveal-delay-5" style="margin-top: 2.5rem;">
        Start your journey
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 8rem 2.5rem;
    max-width: 1360px;
    margin: 0 auto;
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7rem;
    align-items: start;
  }

  /* Image column */
  .about-image-col {
    position: sticky;
    top: 7rem;
  }

  .about-frame {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .about-img-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: linear-gradient(145deg, var(--color-cream-dark), #d5ccbe);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .about-img-placeholder svg {
    width: 72px;
    height: 72px;
    opacity: 0.35;
  }

  .about-img-placeholder span {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b0a898;
    font-weight: 400;
  }

  .about-frame-deco {
    position: absolute;
    top: -16px;
    left: -16px;
    right: 16px;
    bottom: 16px;
    border: 1.5px solid var(--color-cream-dark);
    border-radius: 18px;
    z-index: -1;
  }

  /* Credentials */
  .about-credentials {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: white;
    border-radius: 16px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
  }

  .cred-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .cred-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .cred-title {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-forest);
  }

  .cred-sub {
    font-size: 0.72rem;
    color: #999;
    margin-top: 0.1rem;
  }

  /* Text column */
  .about-heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    line-height: 1.1;
    color: var(--color-forest);
    margin-bottom: 2rem;
  }

  .about-heading em {
    font-style: italic;
    color: var(--color-terra);
  }

  .about-p {
    font-size: 1.02rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 1.25rem;
    font-weight: 300;
  }

  .about-p strong {
    color: var(--color-forest);
    font-weight: 500;
  }

  /* Values */
  .about-values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-ink);
    font-weight: 400;
  }

  .value-icon {
    color: var(--color-gold);
    font-size: 0.65rem;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .about-image-col {
      position: static;
    }

    .about-img-placeholder {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 480px) {
    .about {
      padding: 5rem 1.5rem;
    }
  }
</style>
