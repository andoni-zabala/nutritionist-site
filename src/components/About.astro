---

---

<section class="about" id="about">
  <div class="about-overlay" aria-hidden="true"></div>

  <div class="about-inner">
    <!-- Photo column -->
    <div class="about-photo-col reveal">
      <div class="about-photo-wrap">
        <img
          src="/uploads/mabel_2.webp"
          alt="Mabel Gomez - Licenciada en Nutrición"
          class="about-photo"
          width="480"
          height="600"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Content column -->
    <div class="about-content-col">
      <div class="section-tag section-tag--light reveal">Sobre mí</div>

      <h2 class="about-heading reveal reveal-delay-1">
        La nutricionista que entiende<br />
        que <em>cada cuerpo es diferente.</em>
      </h2>

      <div class="about-body reveal reveal-delay-2">
        <p class="about-p">
          Soy Licenciada en Nutrición con formación en Nutrición Funcional e
          Integrativa. Mi perfil profesional se enfoca en microbiota intestinal,
          salud digestiva, nutrición antiinflamatoria basada en el modelo de
          alimentación mediterránea y estrategias orientadas a la longevidad y
          el envejecimiento saludable, acompañando a personas que buscan mejorar
          su salud y bienestar desde un enfoque integral y basado en evidencia
          científica.
        </p>

        <p class="about-p">
          Además, soy docente universitaria y coordino grupos de descenso de
          peso y reeducación alimentaria, acompañando procesos de cambio de
          manera humana, realista y sostenible. En consulta también realizo
          evaluación y medición de composición corporal como parte del
          seguimiento nutricional.
        </p>

        <p class="about-p">
          Actualmente realizo atención nutricional presencial y online desde una
          mirada funcional e integrativa.
        </p>
      </div>

      <div class="about-values reveal reveal-delay-3">
        <div class="value">
          <span class="value-icon">✦</span>
          <span>Plan hecho para vos</span>
        </div>
        <div class="value">
          <span class="value-icon">✦</span>
          <span>Bienestar real</span>
        </div>
        <div class="value">
          <span class="value-icon">✦</span>
          <span>Sin restricciones extremas</span>
        </div>
        <div class="value">
          <span class="value-icon">✦</span>
          <span>Resultados duraderos</span>
        </div>
      </div>

      <!-- Specialty icon badges -->
      <div class="about-specialties reveal reveal-delay-3">
        <div class="specialty-badge">
          <div class="specialty-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.4"/>
              <path d="M7 10.5C7.8 13 12.2 13 13 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="7.5" cy="8" r="1" fill="currentColor"/>
              <circle cx="12.5" cy="8" r="1" fill="currentColor"/>
            </svg>
          </div>
          <span>Microbiota intestinal</span>
        </div>
        <div class="specialty-badge">
          <div class="specialty-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M10 3C10 3 5.5 6.5 5.5 10.5C5.5 13.2 7.5 15.5 10 15.5C12.5 15.5 14.5 13.2 14.5 10.5C14.5 6.5 10 3 10 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M10 15.5V18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <path d="M8 18H12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <span>Nutrición antiinflamatoria</span>
        </div>
        <div class="specialty-badge">
          <div class="specialty-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M3 14L7 9.5L10 12L14 6L17 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3 17H17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.4"/>
            </svg>
          </div>
          <span>Longevidad y salud</span>
        </div>
        <div class="specialty-badge">
          <div class="specialty-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="3" y="3" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M7 8H13M7 11H11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="15" cy="15" r="3.5" fill="white" stroke="currentColor" stroke-width="1.2"/>
              <path d="M14 15H16M15 14V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </div>
          <span>Composición corporal</span>
        </div>
      </div>

      <a
        href="#contact"
        class="btn-primary btn-primary--light reveal reveal-delay-4"
      >
        Quiero saber más
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    background-image: url("/uploads/food.webp");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    padding: 9rem 2.5rem;
  }

  .about-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(12, 28, 10, 0.95) 0%,
      rgba(20, 40, 18, 0.88) 50%,
      rgba(15, 30, 13, 0.94) 100%
    );
  }

  .about-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 7rem;
    align-items: center;
  }

  /* ── Photo column ── */
  .about-photo-col {
    position: relative;
  }

  .about-photo-wrap {
    position: relative;
  }

  .about-photo {
    width: 100%;
    height: 580px;
    object-fit: cover;
    object-position: center top;
    border-radius: 20px;
    display: block;
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .about-photo-badge {
    position: absolute;
    z-index: 2;
    bottom: -18px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-forest);
    border: 1.5px solid rgba(122, 158, 104, 0.4);
    border-radius: 100px;
    padding: 0.55rem 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .badge-icon {
    color: var(--color-gold);
    font-size: 0.55rem;
  }

  .badge-text {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  /* ── Content column ── */
  .about-content-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about-heading {
    font-size: clamp(2.2rem, 3vw, 3.2rem);
    line-height: 1.1;
    color: var(--color-cream);
    margin-bottom: 2.5rem;
  }

  .about-heading em {
    font-style: italic;
    color: var(--color-terra);
  }

  .about-body {
    max-width: 580px;
  }

  .about-p {
    font-size: 1rem;
    line-height: 1.85;
    color: rgba(250, 247, 240, 0.85);
    margin-bottom: 1.25rem;
    font-weight: 300;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .about-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(250, 247, 240, 0.18);
    width: 100%;
  }

  .value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-cream);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .value-icon {
    color: var(--color-gold);
    font-size: 0.6rem;
    flex-shrink: 0;
  }

  /* Specialty badges */
  .about-specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    width: 100%;
  }

  .specialty-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(250, 247, 240, 0.07);
    border: 1px solid rgba(250, 247, 240, 0.14);
    border-radius: 100px;
    padding: 0.4rem 0.85rem 0.4rem 0.55rem;
    font-size: 0.72rem;
    color: rgba(250, 247, 240, 0.8);
    font-weight: 400;
    letter-spacing: 0.03em;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .specialty-badge:hover {
    background: rgba(250, 247, 240, 0.12);
    border-color: rgba(250, 247, 240, 0.22);
  }

  .specialty-icon {
    color: var(--color-sage-light);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .btn-primary--light {
    background: var(--color-cream);
    color: var(--color-forest);
  }

  .btn-primary--light:hover {
    background: var(--color-cream-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .about {
      background-attachment: scroll;
      padding: 7rem 2.5rem;
    }

    .about-inner {
      grid-template-columns: 1fr;
      gap: 4rem;
      text-align: center;
    }

    .about-photo-col {
      max-width: 360px;
      margin: 0 auto;
    }

    .about-content-col {
      align-items: center;
    }

    .about-body {
      max-width: 640px;
    }

    .about-values {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .about {
      padding: 6rem 1.5rem;
    }

    .about-photo {
      height: 440px;
    }

    .about-values {
      gap: 0.75rem 1.5rem;
    }
  }
</style>
