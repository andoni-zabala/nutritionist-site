          </a>
        </div>

        <div class="contact-details reveal reveal-delay-2">
          <div class="detail">
            <span class="detail-icon">📍</span>
            <div>
              <span class="detail-label">Ubicación</span>
              <span class="detail-val">Consultas online y presenciales</span>
            </div>
          </div>
          <div class="detail">
            <span class="detail-icon">🕐</span>
            <div>
              <span class="detail-label">Horario</span>
              <span class="detail-val">Lun-Vie, 9:00 a 18:00hs</span>
            </div>
          </div>
          <div class="detail">
            <span class="detail-icon">✉</span>
            <div>
              <span class="detail-label">Email</span>
              <a href="mailto:nutrymaby@gmail.com" class="detail-val">
                nutrymaby@gmail.com
              </a>
            </div>
          </div>
        </div>

        <div class="social-links reveal reveal-delay-3">
          <a
            href="https://www.instagram.com/nutry_maby/"
            class="social-link social-link--instagram"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            Instagram
          </a>
          <a
            href="https://www.facebook.com/nutry.maby"
            class="social-link social-link--facebook"
            aria-label="Facebook"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                d="M18 2h-3a6 6 0 0 0-6 6v3H7v4h2v8h4v-8h3l1-4h-4V8a2 2 0 0 1 2-2h1z"
              ></path>
            </svg>
            Facebook
          </a>
          <a
            href="https://www.tiktok.com/@nutrymaby"
            class="social-link social-link--tiktok"
            aria-label="TikTok"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
            TikTok
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 8rem 2.5rem;
    max-width: 1360px;
    margin: 0 auto;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .contact-photo img {
    width: 100%;
    max-width: 680px;
    height: auto;
    border-radius: 20px;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.12));
  }

  .contact-content {
    min-width: 0;
  }

  .contact-heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    line-height: 1.1;
    color: var(--color-forest);
    margin-bottom: 1.25rem;
  }

  .contact-heading em {
    font-style: italic;
    color: var(--color-terra);
  }

  .contact-sub {
    font-size: 1rem;
    line-height: 1.75;
    color: #666;
    font-weight: 300;
    margin-bottom: 0;
  }

  .contact-body {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* WhatsApp card */
  .wa-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: white;
    border: 1.5px solid var(--color-cream-dark);
    border-radius: 20px;
    padding: 1.75rem 2rem;
  }

  .wa-card-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    background: rgba(37, 211, 102, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #25d366;
  }

  .wa-card-text {
    flex: 1;
  }

  .wa-card-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #aaa;
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .wa-card-number {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }

  .wa-card-number:hover {
    color: var(--color-forest);
  }

  .btn-wa-large {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #25d366;
    color: white;
    padding: 0.85rem 1.75rem;
    border-radius: 100px;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.3);
    white-space: nowrap;
  }

  .btn-wa-large:hover {
    background: #1ebe5d;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(37, 211, 102, 0.38);
  }

  /* Details row */
  .contact-details {
    display: flex;
    gap: 2.5rem;
  }

  .detail {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .detail-icon {
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .detail-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #aaa;
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .detail-val {
    font-size: 0.88rem;
    color: var(--color-ink);
    font-weight: 400;
    text-decoration: none;
  }

  a.detail-val:hover {
    color: var(--color-forest);
    text-decoration: underline;
  }

  /* Social links */
  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-forest);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    border: 1.5px solid var(--color-cream-dark);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    background: var(--color-forest);
    color: var(--color-cream);
    border-color: var(--color-forest);
  }

  .social-link--instagram {
    color: #e4405f;
    border-color: #e4405f;
  }

  .social-link--instagram:hover {
    background: #e4405f;
    color: white;
    border-color: #e4405f;
  }

  .social-link--facebook {
    color: #1877f2;
    border-color: #1877f2;
  }

  .social-link--facebook:hover {
    background: #1877f2;
    color: white;
    border-color: #1877f2;
  }

  .social-link--tiktok {
    color: #000;
    border-color: #000;
  }

  .social-link--tiktok:hover {
    background: #000;
    color: white;
    border-color: #000;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-photo img {
      max-width: 400px;
      margin: 0 auto;
      display: block;
    }
  }

  @media (max-width: 640px) {
    .wa-card {
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .btn-wa-large {
      width: 100%;
      justify-content: center;
    }

    .contact-details {
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .contact {
      padding: 5rem 1.5rem;
    }

    .social-links {
      flex-wrap: wrap;
    }
  }
</style>
