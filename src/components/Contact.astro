---

---

<section class="contact" id="contact">
  <div class="contact-inner">
    <div class="contact-info reveal">
      <div class="section-tag">Contacto</div>
      <h2 class="contact-heading">
        Empezá hoy a mejorar<br /><em>tu alimentación</em>
      </h2>
      <p class="contact-sub">
        No se trata de hacer una dieta más, sino de aprender a comer mejor para
        siempre. La forma más rápida de empezar es por WhatsApp.
      </p>

      <a
        href="https://wa.me/message/BTY5IEGJWF67F1"
        class="btn-wa-large"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
        Agendar consulta por WhatsApp
      </a>

      <div class="contact-details">
        <div class="detail">
          <span class="detail-icon">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="#25D366"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
          </span>
          <div>
            <span class="detail-label">WhatsApp</span>
            <a
              href="https://wa.me/message/BTY5IEGJWF67F1"
              class="detail-val"
              target="_blank"
              rel="noopener noreferrer">+54 9 11 6659-8030</a
            >
          </div>
        </div>
        <div class="detail">
          <span class="detail-icon">✉</span>
          <div>
            <span class="detail-label">Email</span>
            <a href="mailto:nutrymaby@gmail.com" class="detail-val">
              nutrymaby@gmail.com
            </a>
          </div>
        </div>
        <div class="detail">
          <span class="detail-icon">📍</span>
          <div>
            <span class="detail-label">Ubicación</span>
            <span class="detail-val">Consultas online y presenciales</span>
          </div>
        </div>
        <div class="detail">
          <span class="detail-icon">🕐</span>

          <div>
            <span class="detail-label">Horario</span>
            <span class="detail-val">Lun–Vie, 9:00–18:00</span>
          </div>
        </div>
      </div>

      <div class="social-links">
        <a
          href="https://www.instagram.com/nutry_maby/"
          class="social-link social-link--instagram"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          Instagram
        </a>
        <a
          href="https://www.facebook.com/nutry.maby"
          class="social-link social-link--facebook"
          aria-label="Facebook"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M18 2h-3a6 6 0 0 0-6 6v3H7v4h2v8h4v-8h3l1-4h-4V8a2 2 0 0 1 2-2h1z"></path>
          </svg>
          Facebook
        </a>
        <a
          href="https://www.tiktok.com/@nutrymaby"
          class="social-link social-link--tiktok"
          aria-label="TikTok"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
          </svg>
          TikTok
        </a>
      </div>
    </div>

    <div class="contact-form-wrap reveal reveal-delay-2">
      <form class="contact-form" name="contact" netlify>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Nombre completo</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="María González"
              required
            />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="maria@email.com"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="goal">Objetivo principal</label>
          <select id="goal" name="goal" required>
            <option value="" disabled selected
              >Selecciona tu objetivo principal…</option
            >
            <option value="digestive">Salud digestiva</option>
            <option value="microbiota">Microbiota intestinal</option>
            <option value="inflammation">Reducir inflamación</option>
            <option value="weight">Control de peso</option>
            <option value="energy">Más energía y vitalidad</option>
            <option value="other">Otro</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message">Cuéntame un poco sobre ti</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="¿Qué está pasando? ¿Qué has probado antes? Cualquier contexto es útil…"
            required></textarea>
        </div>

        <div class="form-group form-group--check">
          <label class="checkbox-label">
            <input type="checkbox" name="newsletter" />
            <span>Suscribirme al boletín mensual de nutrición</span>
          </label>
        </div>

        <button type="submit" class="btn-primary form-submit">
          Enviar consulta
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 8rem 2.5rem;
    max-width: 1360px;
    margin: 0 auto;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  /* Info column */
  .contact-heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    line-height: 1.1;
    color: var(--color-forest);
    margin-bottom: 1.25rem;
  }

  .contact-heading em {
    font-style: italic;
    color: var(--color-terra);
  }

  .contact-sub {
    font-size: 1rem;
    line-height: 1.75;
    color: #666;
    font-weight: 300;
    margin-bottom: 2.5rem;
  }

  .btn-wa-large {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #25d366;
    color: white;
    padding: 0.9rem 2rem;
    border-radius: 100px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition:
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.3);
  }

  .btn-wa-large:hover {
    background: #1ebe5d;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(37, 211, 102, 0.38);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .detail {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .detail-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .detail-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #aaa;
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .detail-val {
    font-size: 0.88rem;
    color: var(--color-ink);
    font-weight: 400;
    text-decoration: none;
  }

  a.detail-val:hover {
    color: var(--color-forest);
    text-decoration: underline;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-forest);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    border: 1.5px solid var(--color-cream-dark);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    background: var(--color-forest);
    color: var(--color-cream);
    border-color: var(--color-forest);
  }

  .social-link--instagram {
    color: #E4405F;
    border-color: #E4405F;
  }

  .social-link--instagram:hover {
    background: #E4405F;
    color: white;
    border-color: #E4405F;
  }

  .social-link--facebook {
    color: #1877F2;
    border-color: #1877F2;
  }

  .social-link--facebook:hover {
    background: #1877F2;
    color: white;
    border-color: #1877F2;
  }

  .social-link--tiktok {
    color: #000;
    border-color: #000;
  }

  .social-link--tiktok:hover {
    background: #000;
    color: white;
    border-color: #000;
  }

  /* Form */
  .contact-form-wrap {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    border: 1.5px solid var(--color-cream-dark);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #777;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-ink);
    background: var(--color-cream);
    border: 1.5px solid var(--color-cream-dark);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    outline: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    width: 100%;
    appearance: none;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-sage);
    box-shadow: 0 0 0 3px rgba(122, 158, 104, 0.12);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #bbb;
  }

  .form-group--check {
    flex-direction: row;
    align-items: center;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: #666;
    cursor: pointer;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }

  .checkbox-label input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-forest);
    cursor: pointer;
  }

  .form-submit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    justify-content: center;
    font-size: 0.9rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .contact {
      padding: 5rem 1.5rem;
    }

    .contact-form-wrap {
      padding: 1.75rem;
    }
  }
</style>
