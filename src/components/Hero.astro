  <div class="hero-visual reveal reveal-delay-2">
    <div class="photo-frame">
      <img
        src="/mabel-gomez.jpg"
        alt="Mabel Gomez - Licenciada en Nutrición"
        class="hero-photo"
        width="400"
        height="500"
        loading="eager"
      />

      <div class="badge">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1l1.56 3.16L12 4.76l-2.5 2.43.59 3.43L7 9l-3.09 1.62.59-3.43L2 4.76l3.44-.6L7 1z" fill="#BF8C40"/>
