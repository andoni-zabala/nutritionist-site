---
import settings from "../data/settings.json";
---

<section class="hero">
  <!-- Background orb -->
  <div class="hero-orb" aria-hidden="true"></div>
  <div class="hero-orb-2" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-eyebrow reveal">
      <span class="eyebrow-dot"></span>
      Aceptando nuevos pacientes
    </div>

    <h1 class="hero-heading reveal reveal-delay-1">
      <em>Transformá</em> tu alimentación<br />
      sin dietas estrictas.
    </h1>

    <p class="hero-body reveal reveal-delay-2">
      Soy Lic. Mabel Gómez, nutricionista funcional integrativa. Te ayudo a
      mejorar tu salud y lograr resultados sostenibles con un plan personalizado
      sin restricciones extremas ni efecto rebote.
    </p>

    <div class="hero-actions reveal reveal-delay-3">
      <a
        href="https://wa.me/message/BTY5IEGJWF67F1"
        class="btn-primary btn-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
        Agendar consulta por WhatsApp
      </a>
      <a href="#how-it-works" class="hero-link">
        Ver cómo funciona
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="hero-stats reveal reveal-delay-4">
      <div class="stat">
        <span class="stat-n">✓</span>
        <span class="stat-l">Sin dietas restrictivas</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-n">✓</span>
        <span class="stat-l">Resultados sostenibles</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-n">✓</span>
        <span class="stat-l">Plan 100% personalizado</span>
      </div>
    </div>
  </div>

  <div class="hero-visual reveal reveal-delay-2">
    <div class="photo-frame">
      <img
        src={settings.profilePhoto}
        alt="Mabel Gomez - Licenciada en Nutrición"
        class="hero-photo"
        width="400"
        height="500"
        loading="eager"
      />

      <div class="float-card float-card--photo-left">
        <span class="float-icon">🥑</span>
        <div class="float-text">
          <span class="float-label">Enfoque</span>
          <span class="float-val">Nutrición antinflamatoria</span>
        </div>
      </div>
    </div>

    <div class="float-card">
      <span class="float-icon">💻</span>
      <div class="float-text">
        <span class="float-label">Disponible</span>
        <span class="float-val">Online y presencial</span>
      </div>
    </div>

    <div class="float-card float-card--bottom">
      <span class="float-icon">✓</span>
      <div class="float-text">
        <span class="float-label">Resultado</span>
        <span class="float-val">Hábitos reales y sostenibles</span>
      </div>
    </div>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <div class="scroll-line"></div>
    <span>scroll</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    max-width: 1360px;
    margin: 0 auto;
    padding: 7rem 2.5rem 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 5rem;
    position: relative;
    overflow: hidden;
  }

  /* Ambient background shapes */
  .hero-orb {
    position: absolute;
    top: -120px;
    right: -180px;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(122, 158, 104, 0.1) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .hero-orb-2 {
    position: absolute;
    bottom: 80px;
    left: -100px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(200, 96, 58, 0.06) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  /* Content */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-sage);
    font-weight: 500;
    margin-bottom: 1.75rem;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-sage);
    animation: blink 2.5s ease-in-out infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .hero-heading {
    font-size: clamp(3.2rem, 5.5vw, 6rem);
    line-height: 1;
    color: var(--color-forest);
    margin-bottom: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .hero-heading em {
    font-style: italic;
    color: var(--color-terra);
  }

  .hero-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #5a5a55;
    max-width: 460px;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #25d366 !important;
  }

  .btn-whatsapp:hover {
    background: #1ebe5d !important;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-forest);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: gap 0.2s ease;
  }

  .hero-link:hover {
    gap: 0.65rem;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-n {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-sage);
    line-height: 1;
  }

  .stat-l {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #999;
    font-weight: 400;
  }

  .stat-sep {
    width: 1px;
    height: 36px;
    background: var(--color-cream-dark);
  }

  /* Visual area */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }

  .photo-frame {
    position: relative;
    width: 400px;
    height: 500px;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 10% 95%;
    border-radius: 200px 200px 140px 140px;
    filter: brightness(1.05) contrast(1.02);
  }

  /* Floating cards */
  .float-card {
    position: absolute;
    top: 48px;
    right: -32px;
    background: white;
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 195px;
  }

  .float-card--bottom {
    top: auto;
    bottom: 80px;
    right: -40px;
  }

  .float-card--photo-left {
    top: auto;
    right: auto;
    bottom: 28px;
    left: -32px;
  }

  .float-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .float-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .float-label {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #bbb;
    font-weight: 500;
  }

  .float-val {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-forest);
  }

  /* Scroll indicator */
  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #bbb;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, #ccc);
    animation: scrollAnim 2s ease infinite;
  }

  @keyframes scrollAnim {
    0% {
      transform: scaleY(0);
      transform-origin: top;
      opacity: 1;
    }
    49% {
      transform: scaleY(1);
      transform-origin: top;
      opacity: 1;
    }
    50% {
      transform: scaleY(1);
      transform-origin: bottom;
      opacity: 1;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
      opacity: 0;
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
      padding-top: 6rem;
    }

    .hero-visual {
      order: -1;
    }

    .photo-frame {
      width: 300px;
      height: 380px;
    }

    .hero-body,
    .hero-eyebrow {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions,
    .hero-stats {
      justify-content: center;
    }

    .float-card {
      display: none;
    }

    .scroll-hint {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 5.5rem 1.5rem 3rem;
    }

    .hero-stats {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .stat {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }

    .stat-sep {
      display: none;
    }

    .float-card {
      display: flex;
      width: 155px;
      padding: 0.6rem 0.8rem;
      gap: 0.5rem;
      top: 40px;
      right: 8px;
    }

    .float-card--bottom {
      top: auto;
      bottom: 40px;
      right: 8px;
    }

    .float-card--photo-left {
      top: auto;
      right: auto;
      bottom: 20px;
      left: 8px;
    }

    .float-icon {
      font-size: 1.1rem;
    }

    .float-label {
      font-size: 0.55rem;
    }

    .float-val {
      font-size: 0.68rem;
    }
  }
</style>
